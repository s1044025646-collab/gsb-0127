{
  "name": "ocr-layout-backend",
  "version": "1.0.0",
  "description": "Local OCR layout reading-order and table reconstruction backend (API + CLI + synthetic generator + tests). No real OCR, no network services.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-strip-types src/cli/index.ts serve",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "test": "node --experimental-strip-types --test --test-reporter=spec test/",
    "demo": "node --experimental-strip-types demo/run-demo.ts",
    "clean": "node --experimental-strip-types scripts/clean.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
